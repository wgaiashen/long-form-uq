#!/bin/bash
#PBS -l select=1:ncpus=8:mem=96gb
#PBS -l walltime=05:00:00
#PBS -N luq_keep_seg
#PBS -j oe
set -uo pipefail
cd "$PBS_O_WORKDIR"; source pbs/_env.sh; luq_activate || exit 1; cd "$LUQ_REPO"; export HF_HOME HF_HUB_OFFLINE=1
echo "=== keep-variants SEGMENT only on $(hostname) at $(date) ===" >&2
python -u scripts/checks/weighted_msp_keep_variants.py --seeds 1,2,3 --modes segment \
  --out results/weighted_msp_keep_variants__segment__meta-llama_Meta-Llama-3.1-8B.csv
echo "=== done $(date) ===" >&2
