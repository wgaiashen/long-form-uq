#!/bin/bash
#PBS -l select=1:ncpus=4:mem=48gb
#PBS -l walltime=08:00:00
#PBS -N luq_pdlU
#PBS -j oe
# ProbeDriftLong UNIVERSAL (ExpertQA faithfulness added as a training source -> mixed-label long pool), ONE eval.
set -uo pipefail
cd "$PBS_O_WORKDIR"; source pbs/_env.sh; luq_activate || exit 1; cd "$LUQ_REPO"; export HF_HOME HF_HUB_OFFLINE=1
echo "=== ProbeDriftLong-UNIVERSAL[$EVAL] on $(hostname) at $(date) ===" >&2
python -u scripts/checks/probedriftlong.py --evals "$EVAL" --seeds 1,2,3 --include-expertqa \
  --out "results/probedriftlong_universal_${EVAL}__meta-llama_Meta-Llama-3.1-8B.csv"
echo "=== done $(date) ===" >&2
