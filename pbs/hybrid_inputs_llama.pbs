#!/bin/bash
#PBS -l select=1:ncpus=4:mem=64gb:ngpus=1:gpu_type=L40S
#PBS -l walltime=24:00:00
#PBS -N luq_hybin_llama
#PBS -j oe

# The two GPU inputs the published hybrid baselines need that no existing cache supplies, for
# meta-llama/Meta-Llama-3.1-8B on its corrected-span eight-dataset population.
#
# 1. PER-TOKEN PREDICTIVE ENTROPY. The MSP-SATMD / MSP-SATRMD meta-regressor is fitted on
#    [mean Mahalanobis distance, MSP, MEAN TOKEN ENTROPY]. The Tier-1 record stores only the chosen
#    token's log-probability, so the third feature cannot be derived from it. Roughly 2 h for the
#    eight datasets.
# 2. C4 BACKGROUND. The relative Mahalanobis variants subtract a distance measured against a
#    general-corpus centroid, generated by this model. About 7 h, and the long pole.
#
# ENTROPY RUNS FIRST, deliberately. It is the cheaper half and it fails fast if the token window is
# wrong, so a walltime overrun costs the background rather than both.
#
# dtype/attn are fp32 + eager, matching every other Llama artifact. Anything else changes the hidden
# states and the entropies and makes them incomparable with the per-token caches they are used beside.
#
#   qsub pbs/hybrid_inputs_llama.pbs

set -uo pipefail
cd "$PBS_O_WORKDIR"; source pbs/_env.sh; luq_activate || exit 1; cd "$LUQ_REPO"
export HF_HOME

mkdir -p logs
LIVE="logs/hybrid_inputs_llama__${PBS_JOBID%%.*}.log"
exec > >(tee -a "$LIVE") 2>&1
echo "live log: $LIVE"

MODEL="meta-llama/Meta-Llama-3.1-8B"
LAYER=15
DTYPE=fp32
ATTN=eager

echo "=== hybrid inputs, $MODEL === host=$(hostname) at $(date)"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader || true

STATUS=0

# dataset:regime for the corrected-span population. The regime is the cache namespace, and an empty
# one means the canonical namespace. These are the eight datasets of the report-facing grid.
SPECS=(
  "pubmed_qa:"
  "xsum:"
  "cnn_dailymail:"
  "samsum:"
  "med_quad:cleanv2"
  "asqa:asqa_rp12"
  "expertqa:expertqa_rp12"
  "factscore:factscore_rp12"
)

echo; echo "################ STAGE 1: per-token predictive entropy ################ $(date)"
for spec in "${SPECS[@]}"; do
  DS="${spec%%:*}"; RG="${spec#*:}"
  echo; echo "---- $DS (regime '${RG:-canonical}') ---- $(date)"
  python -u scripts/01n_token_entropy.py --model "$MODEL" --dataset "$DS" --ood ID \
      --dtype "$DTYPE" --attn "$ATTN" --prompt-regime "$RG" \
      || { echo "!!! entropy FAILED for $DS"; STATUS=1; }
done

echo; echo "################ STAGE 2: C4 background ################ $(date)"
# Budget 384 is the largest generation budget in the long-form grid (expertqa). Greedy decoding makes
# every shorter budget an exact prefix of this run, and the script measures that rather than assuming
# it, so one pass serves all eight datasets.
python -u scripts/01m_background_c4.py --model "$MODEL" --layer "$LAYER" \
    --n 2000 --seed 1 --budget 384 --max-prompt-tokens 2048 \
    --dtype "$DTYPE" --attn "$ATTN" --verify-prefix 8 \
    || { echo "!!! C4 background FAILED"; STATUS=1; }

echo; echo "=== hybrid inputs done status=$STATUS at $(date) ==="
exit $STATUS
