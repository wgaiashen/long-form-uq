#!/bin/bash
#PBS -l select=1:ncpus=4:mem=24gb
#PBS -l walltime=00:30:00
#PBS -N luq_orgad_leak
#PBS -j oe
set -uo pipefail
cd "$PBS_O_WORKDIR"; source pbs/_env.sh; luq_activate || exit 1; cd "$LUQ_REPO"; export HF_HOME
echo "=== orgad label-leak check on $(hostname) at $(date) ===" >&2
python -u scripts/checks/orgad_label_leak.py
echo "=== done at $(date) ===" >&2
