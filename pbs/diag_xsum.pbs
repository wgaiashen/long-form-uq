#!/bin/bash
#PBS -l select=1:ncpus=4:mem=32gb
#PBS -l walltime=01:00:00
#PBS -N diag_xsum
#PBS -j oe

# Diagnose the xsum per-token L15 alignment-gate failure (bf16 vs stale-saplma). CPU-only,
# read-only; loads the 2.2GB xsum cache + sciq control -> compute node, not login.
#   qsub pbs/diag_xsum.pbs

set -uo pipefail
cd "$PBS_O_WORKDIR"
source pbs/_env.sh
luq_activate || exit 1
cd "$LUQ_REPO"
export HF_HOME
export HF_HUB_OFFLINE=1

echo "diag_xsum on $(hostname) at $(date)" >&2
python -u scripts/checks/diag_xsum_pertok.py
