#!/bin/bash
#PBS -l select=1:ncpus=8:mem=120gb:ngpus=4:gpu_type=RTX6000
#PBS -l walltime=24:00:00
#PBS -N luq_m11ext4
#PBS -j oe

# Per-token hidden states for ONE layer, over the eight long-form datasets. Extraction only.
# Registered in prereg/M11_alllayer_published_distance_baselines.md.
#
# FOUR CARDS, FOR THE LONG-SOURCE DATASETS. The eager attention backend materialises the full
# attention matrix, which for a source of about 5,900 tokens in float32 is roughly 3.7 GB on top of
# the weights. Two cards at a 17 GiB ceiling leave no room for that and the extraction runs out of
# memory; spreading the weights over four cards at 9 GiB each leaves the headroom the activations
# need. This is the arrangement the earlier multi-layer extraction used for the same dataset, for the
# same reason. Only where the weights live differs; every value written is identical.
#
# Use it with LUQ_M11_DATASETS to name the datasets that need it, e.g.
#   qsub -v LUQ_M11_LAYER=2,LUQ_M11_DATASETS=xsum pbs/m11_extract_4gpu.pbs
#
# SHARDED ACROSS SMALLER CARDS. This is the same job as pbs/m11_extract.pbs and computes the
# same values; only where the weights live differs. It exists because the 48 GB cards on this cluster
# are fully subscribed while the 24 GB ones are not, and a float32 8B model does not fit on one 24 GB
# card. Two of them with a ceiling of 17 GiB each does fit, which is the arrangement the earlier
# multi-layer extraction on this cluster used. The dtype, the sequence handling and every value
# written are identical to the single-card job.
#
# The accelerator is recorded in every cell file the scan later writes, so a layer produced here can
# always be told from one produced elsewhere.
#
# WHY EXTRACTION AND SCANNING ARE SEPARATE JOBS HERE. The scan subtracts a background distance, and
# the background statistics for every layer are computed on one machine so that they do not carry a
# per-layer accelerator difference of their own (amendment A1.5). Extraction does not depend on the
# background at all, so it runs now and the scan follows when the background has arrived and been
# verified. Nothing waits that does not have to.
#
# NOTHING IS DELETED. There is room for these layers alongside the ones already cached, and under
# amendment A1.4 the cached layers stay until every scan has passed its checks and the combined
# result exists. The other cluster deletes as it goes only because its storage cap leaves no choice.
#
#   for L in 2 5 8 11 14 17 20 23 26 29; do qsub -v LUQ_M11_LAYER=$L pbs/m11_extract_4gpu.pbs; done

set -uo pipefail
cd "$PBS_O_WORKDIR"; source pbs/_env.sh; luq_activate || exit 1; cd "$LUQ_REPO"

mkdir -p logs
L="${LUQ_M11_LAYER:?set LUQ_M11_LAYER, e.g. qsub -v LUQ_M11_LAYER=2 pbs/m11_extract.pbs}"
LIVE="logs/m11_extract4_L${L}__${PBS_JOBID%%.*}.log"
exec > >(tee -a "$LIVE") 2>&1
echo "live log: $LIVE"
echo "commit: $(git rev-parse HEAD 2>/dev/null)"

export HF_HOME
export HF_HUB_OFFLINE=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export LUQ_REGIME="med_quad=cleanv2"

MODEL="meta-llama/Meta-Llama-3.1-8B"
SLUG="meta-llama_Meta-Llama-3.1-8B"
FAILED=""

echo "=== extraction, layer $L === host=$(hostname) at $(date)"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null
df -h /rds/general/user/gs925/home | tail -1

# One layer over eight datasets is about 19 GB. Finding that out after hours of work wastes the job.
#
# THE QUOTA IS THE LIMIT, NOT THE FILESYSTEM. `df` on this path reports the shared filesystem, which
# has over a petabyte free and would make this check pass unconditionally. What actually stops a write
# is the per-user allocation.
#
# BUT THE QUOTA TOOL IS NOT AVAILABLE ON COMPUTE NODES. It reports nothing here, so the figure is
# measured on the submitting node instead and passed in. An earlier version refused to start when it
# could not read the quota, which cost a scheduled slot on a queue this contended and protected
# nothing: the real consequence of running out of space is a write error part way through, and the
# per-dataset resume above turns that into a resubmission rather than lost work. So a missing figure
# now warns loudly and proceeds, while a figure that IS available and too small still stops the job.
#
#   qsub -v LUQ_M11_LAYER=$L,LUQ_QUOTA_FREE_GB=$(quota_free_gb) pbs/m11_extract.pbs
AVAIL="${LUQ_QUOTA_FREE_GB:-}"
if [ -z "$AVAIL" ]; then
  read -r U L < <(quota -s 2>/dev/null | awk '/Home/{u=$3;l=$5;gsub(/[^0-9.]/,"",u);gsub(/[^0-9.]/,"",l); if(l<10) l=l*1024; printf "%.0f %.0f\n",u,l}')
  [ -n "${U:-}" ] && [ -n "${L:-}" ] && AVAIL=$((L - U))
fi
if [ -z "$AVAIL" ]; then
  echo "WARNING: could not determine the storage quota here and none was passed in. Proceeding."
  echo "         One layer needs about 19 GB. If the allocation is full this will fail on a write,"
  echo "         and the per-dataset resume above makes that recoverable by resubmitting."
else
  echo "quota headroom at submission: ${AVAIL} GB"
  [ "$AVAIL" -ge 40 ] || { echo "!!! under 40 GB of quota free; not starting"; exit 2; }
fi

# WHICH DATASETS, and why the order matters. A failure used to abort the loop, and the longest-source
# dataset sits second, so one out-of-memory there cost the six datasets after it as well. The loop now
# records a failure and carries on, and the job still exits non-zero naming what failed. Nothing is
# silently skipped: the scan afterwards refuses a layer that is not complete.
#
# LUQ_M11_DATASETS overrides the list, which is how the long-source datasets are given more cards.
for DS in ${LUQ_M11_DATASETS:-pubmed_qa xsum cnn_dailymail samsum med_quad asqa expertqa factscore}; do
  case "$DS" in
    med_quad)  REGIME="cleanv2" ;;
    asqa)      REGIME="asqa_rp12" ;;
    expertqa)  REGIME="expertqa_rp12" ;;
    factscore) REGIME="factscore_rp12" ;;
    *)         REGIME="" ;;
  esac
  # RESUMABILITY. The extractor REFUSES a layer that already exists rather than skipping it, which is
  # right for it and wrong for a loop: on a resubmission after a walltime overrun the first completed
  # dataset would abort the whole job. So the already-done datasets are skipped here, which is what
  # the extractor's own message tells the caller to do. This is what makes a shorter walltime safe.
  case "$REGIME" in
    "") CACHE_DIR="cache" ;;
    *)  CACHE_DIR="cache/$REGIME" ;;
  esac
  TARGET="${CACHE_DIR}/pertok/${SLUG}__${DS}__ID__L${L}.npz"
  if [ -f "$TARGET" ]; then
    echo "  $DS layer $L already cached, skipping"
    continue
  fi
  echo; echo "---- $DS (regime '${REGIME:-canonical}') at $(date)"
  python -u scripts/01p_pertoken_multi.py --model "$MODEL" --dataset "$DS" --ood ID \
      --layers "$L" --prompt-regime "$REGIME" --dtype fp32 --attn eager \
      --device-map auto --max-memory "0=9GiB,1=9GiB,2=9GiB,3=9GiB" --skip-lm-head \
      || { echo "!!! extraction FAILED for $DS layer $L"; FAILED="$FAILED $DS"; }
done

if [ -n "${FAILED// /}" ]; then
  echo; echo "!!! layer $L is INCOMPLETE. Datasets that failed:$FAILED"
  echo "    Do not scan this layer until they are extracted. The scan checks for 40 cells and will"
  echo "    refuse, but the reason is here."
  df -h /rds/general/user/gs925/home | tail -1
  exit 4
fi

df -h /rds/general/user/gs925/home | tail -1
echo; echo "=== layer $L extracted at $(date). Scan it with:"
echo "      qsub -v LUQ_M11_LAYER=$L pbs/m11_scan.pbs"
