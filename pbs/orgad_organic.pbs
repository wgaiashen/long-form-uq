#!/bin/bash
#PBS -l select=1:ncpus=8:mem=120gb
#PBS -l walltime=06:00:00
#PBS -N luq_orgad_org
#PBS -j oe
set -uo pipefail
cd "$PBS_O_WORKDIR"; source pbs/_env.sh; luq_activate || exit 1; cd "$LUQ_REPO"; export HF_HOME HF_HUB_OFFLINE=1
echo "=== orgad ladder ORGANIC (broad, tau=0.3) on $(hostname) $(date) ===" >&2
python -u scripts/checks/weighted_msp_orgad_ladder.py --seeds 1,2,3   --orgad-variant broad --orgad-floor 0.3   --sources sciq,trivia_qa,pubmed_qa,xsum,cnn_dailymail,med_quad,samsum   --out results/weighted_msp_orgad_ladder_organic__meta-llama_Meta-Llama-3.1-8B.csv
echo "=== done $(date) ===" >&2
