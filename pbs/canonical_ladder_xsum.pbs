#!/bin/bash
#PBS -l select=1:ncpus=8:mem=64gb
#PBS -l walltime=03:00:00
#PBS -N luq_canon_xsum
#PBS -j oe
# Full canonical ladder with xsum ADDED as an OOD eval (all methods: floor, SAPLMA mean-pool/last-token,
# uniform, attention, weighted-MSP norm/Blondel). CPU (poolers + wMSP run on CPU here to skip the GPU queue).
set -uo pipefail
cd "$PBS_O_WORKDIR"; source pbs/_env.sh; luq_activate || exit 1; cd "$LUQ_REPO"; export HF_HOME HF_HUB_OFFLINE=1
echo "=== canonical ladder (xsum eval) on $(hostname) at $(date) ===" >&2
python -u scripts/checks/canonical_ladder.py --evals xsum \
  --sources sciq,trivia_qa,pubmed_qa,xsum,med_quad,samsum --aggregators meanpool,lasttoken --seeds 1,2,3 \
  --out results/canonical_ladder_xsum__meta-llama_Meta-Llama-3.1-8B.csv
echo "=== done at $(date) ===" >&2
