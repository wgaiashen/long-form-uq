#!/bin/bash
#PBS -l select=1:ncpus=2:mem=32gb
# Right-sized 2026-07-22 from MEASURED usage: these drivers run at CPU Percent 99% (single-threaded)
# and peak ~15.6GB, so the old 8cpu/96gb request just made them wait for a slot they never used.
#PBS -l walltime=06:00:00
#PBS -N luq_eqa_agg
#PBS -j oe
# ExpertQA LOCO aggregation ladder: weighted-MSP + attention pooler beside SAPLMA/MSP, per label
# (faithfulness / consistency). CPU-only; the 6.59GB per-token L15 cache loads into RAM (mem=96gb).
set -uo pipefail
cd "$PBS_O_WORKDIR"; source pbs/_env.sh; luq_activate || exit 1; cd "$LUQ_REPO"; export HF_HOME HF_HUB_OFFLINE=1
echo "=== expertqa loco agg on $(hostname) at $(date) ===" >&2
python -u scripts/checks/expertqa_loco_agg.py --labels faithfulness consistency --seeds 1 2 3
echo "=== done at $(date) ===" >&2
