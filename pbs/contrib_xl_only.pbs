#!/bin/bash
#PBS -l select=1:ncpus=8:mem=120gb
#PBS -l walltime=05:00:00
#PBS -N luq_contrib_xl
#PBS -j oe
# contribution ladder XL-ONLY (med_quad/samsum/ExpertQA) -- the pooler XL rows. Core rows already exist
# (unchanged, proven by idea2). Fast because only 3 evals (vs 8) go through the temperature-selected poolers.
set -uo pipefail
cd "$PBS_O_WORKDIR"; source pbs/_env.sh; luq_activate || exit 1; cd "$LUQ_REPO"; export HF_HOME HF_HUB_OFFLINE=1
echo "=== contribution XL-only on $(hostname) $(date) ===" >&2
python -u scripts/checks/contribution_ladder.py --seeds 1,2,3   --evals med_quad,samsum,expertqa   --sources sciq,trivia_qa,pubmed_qa,xsum,cnn_dailymail,med_quad,samsum   --out results/contribution_ladder_organic_XL__meta-llama_Meta-Llama-3.1-8B.csv
echo "=== done $(date) ===" >&2
