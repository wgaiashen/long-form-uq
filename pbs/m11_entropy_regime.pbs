#!/bin/bash
#PBS -l select=1:ncpus=8:mem=96gb:ngpus=2:gpu_type=RTX6000
#PBS -l walltime=04:00:00
#PBS -N luq_m11entreg
#PBS -j oe

# Which generation-time logits processors produced the cached token log-probabilities?
#
# The entropy input the probability-augmented hybrids need exists for three of the eight datasets.
# On the other five the extractor's own alignment check fails, and the failure profile does not look
# like a misaligned window: on one dataset the early positions agree to about 1e-5 and later ones
# differ by several nats, on another every position differs from the first. Both are what a logits
# processor does, because what generate returns in `scores`, and therefore what was cached, is the
# distribution AFTER the processors run.
#
# TWO EXPLANATIONS ARE ON THE TABLE AND THIS SWEEPS BOTH. An earlier diagnostic concluded the cached
# values came from a forward configuration the current fp32-plus-eager recomputation does not
# reproduce, and named dtype or the attention backend, without testing them. It separately rejected a
# repetition penalty because the diverging positions were not enriched for repeated tokens, which is
# weaker than it appears: a penalty renormalises the whole distribution and therefore shifts every
# position, so which ones exceed a tolerance is a question of magnitude rather than of repetition.
#
# This replays five forward configurations against four processor settings and reports which
# combination, if any, reproduces the cached values. It assumes neither explanation.
#
# NOTHING IS WRITTEN. It is a measurement that decides what to do next, not a fix.
#
#   qsub pbs/m11_entropy_regime.pbs

set -uo pipefail
cd "$PBS_O_WORKDIR"; source pbs/_env.sh; luq_activate || exit 1; cd "$LUQ_REPO"

mkdir -p logs
LIVE="logs/m11_entropy_regime__${PBS_JOBID%%.*}.log"
exec > >(tee -a "$LIVE") 2>&1
echo "live log: $LIVE"
echo "commit: $(git rev-parse HEAD 2>/dev/null)"

export HF_HOME
export HF_HUB_OFFLINE=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

echo "=== entropy regime === host=$(hostname) at $(date)"

# One dataset that PASSES is included on purpose. If the plain configuration does not win there, the
# diagnostic itself is wrong and nothing it says about the failing datasets can be believed.
# A CRASH MUST NOT READ AS A NEGATIVE RESULT. The script exits 1 when no candidate configuration
# reproduces the cached values, and it also exits non-zero when it fails for any other reason. Those
# two are different findings and an earlier version of this job printed the same line for both, which
# made six out-of-memory failures look like six datasets where no configuration matched. Exit code 1
# is the finding; anything else is a failure of the job.
run () {
  echo; echo "################ $1 (regime '${2:-canonical}') ################"
  python -u scripts/checks/m11_entropy_regime.py --dataset "$1" --prompt-regime "$2" --n "${3:-6}" \
      --device-map auto --max-memory "0=17GiB,1=17GiB"
  local rc=$?
  case $rc in
    0) ;;
    1) echo "  FINDING: no candidate configuration reproduces the cached values for $1" ;;
    *) echo "  !!! THE DIAGNOSTIC FAILED for $1 (exit $rc). This is NOT a finding about $1."
       FAILURES=$((FAILURES+1)) ;;
  esac
}
FAILURES=0

# THREE DATASETS, NOT EIGHT. The sweep now reloads the model for each forward configuration, so the
# cost is in model loads rather than in records. Three datasets identify the configuration: one that
# already passes the alignment check, and the two whose failure profiles differ most from each other.
# If a configuration reproduces all three, the remaining datasets are confirmations and can be run
# once, cheaply, under that configuration alone.
run pubmed_qa ""            4
run med_quad  "cleanv2"     4
run asqa      "asqa_rp12"   3

echo
if [ "$FAILURES" != "0" ]; then
  echo "=== $FAILURES dataset(s) DID NOT PRODUCE A MEASUREMENT at $(date). Nothing may be concluded"
  echo "    about those datasets from this run."
  exit 5
fi
echo "=== done at $(date), every dataset measured ==="
