#!/bin/bash
#PBS -l select=1:ncpus=8:mem=120gb
#PBS -l walltime=12:00:00
#PBS -N luq_m11gb2
#PBS -q v1_small72a
#PBS -j oe

# Gate B, second half: the layer scan at layer 15, then the comparison that is the gate.
# Registered in prereg/M11_alllayer_published_distance_baselines.md section 5.
#
# THE COMPARISON IS ON PER-EXAMPLE DISTANCE VECTORS, not on their prediction-rejection ratios. A rank
# statistic moves on round-off a distance does not care about, and it can also sit still while
# individual scores move, so it answers neither question.
#
# THE WINDOW IS 'project' HERE ON PURPOSE (amendment A1.3). This half exists to show that the new
# pipeline, restricted to one layer, reproduces the implementation already on record, and that
# implementation was measured under the project window. The reproduction arm uses the reference
# window; that is a different question and a different arm.
#
# It needs the first half to have written its dump.
#
#   qsub -W depend=afterok:<first half> pbs/m11_gate_b2.pbs
set -uo pipefail
cd "$PBS_O_WORKDIR"; source pbs/_env.sh; luq_activate || exit 1; cd "$LUQ_REPO"

mkdir -p logs
LIVE="logs/m11_gate_b2__${PBS_JOBID%%.*}.log"
exec > >(tee -a "$LIVE") 2>&1
echo "live log: $LIVE"
echo "commit: $(git rev-parse HEAD 2>/dev/null)"

export LUQ_REGIME="med_quad=cleanv2"
MODEL="meta-llama/Meta-Llama-3.1-8B"
SLUG="meta-llama_Meta-Llama-3.1-8B"
REF="results/hybrids/pdl_hybrids_unconstrained__${SLUG}.csv"
CTL="results/hybrids/pdl_m11_singlelayer_control__${SLUG}.csv"

echo "=== gate B, second half === host=$(hostname) at $(date)"

if [ ! -d "results/hybrids/mdhybdump__${SLUG}" ]; then
  echo "!!! the first half has not written its per-example distances. Run pbs/m11_gate_b1.pbs first."
  exit 2
fi

echo; echo "################ the layer scan at the same layer and window ################ $(date)"
python -u scripts/checks/md_layer_scan.py --model "$MODEL" --layer 15 --seeds 1,2,3 \
    --window project \
    || { echo "!!! scan FAILED"; exit 5; }

echo; echo "################ gate B ################ $(date)"
python -u scripts/checks/m11_gates.py b \
    --scan "results/hybrids/mdscan__${SLUG}" \
    --dump "results/hybrids/mdhybdump__${SLUG}" \
    || { echo "!!! GATE B FAILED"; exit 6; }

echo; echo "=== done at $(date) ==="
