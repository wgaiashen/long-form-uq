#!/bin/bash
#PBS -l select=1:ncpus=8:mem=24gb
#PBS -l walltime=03:00:00
#PBS -N luq_step4_sar_prefix
#PBS -j oe
set -uo pipefail
cd "$PBS_O_WORKDIR"; source pbs/_env.sh; luq_activate || exit 1; cd "$LUQ_REPO"; export HF_HOME
echo "=== step4_sar_prefix on $(hostname) at $(date) ===" >&2
python -u scripts/checks/sar_prefix_diagnostic.py --n 80
echo "=== done at $(date) ===" >&2
