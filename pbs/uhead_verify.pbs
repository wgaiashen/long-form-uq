#!/bin/bash
#PBS -l select=1:ncpus=4:mem=64gb:ngpus=1:gpu_type=L40S
#PBS -l walltime=00:40:00
#PBS -N luq_uhverify
#PBS -j oe

# RCS/PBSPro twin of slurm/uhead_verify.sbatch. Verify OUR uhead glue against the
# authors' own inference path on a few sciq records. Light (~10 short records), so the
# default L40S is plenty (the Slurm twin uses a40).
#
# Submit:  LUQ_CLUSTER=rcs ./scripts/submit.sh uhead_verify   (or: qsub pbs/uhead_verify.pbs)

set -uo pipefail

cd "$PBS_O_WORKDIR"
source pbs/_env.sh
luq_activate || exit 1
cd "$LUQ_REPO"
export HF_HOME

echo "uhead-verify start on $(hostname) at $(date)"
python scripts/checks/uhead_vs_authors.py --dataset sciq --ood ID \
    --model google/gemma-2-9b-it --n 10
echo "uhead-verify done at $(date)"
