#!/bin/bash
#PBS -l select=1:ncpus=2:mem=32gb
# Right-sized 2026-07-22 from MEASURED usage: these drivers run at CPU Percent 99% (single-threaded)
# and peak ~15.6GB, so the old 8cpu/96gb request just made them wait for a slot they never used.
#PBS -l walltime=10:00:00
#PBS -N luq_orgadB
#PBS -j oe
# W6 (£0 slice) — the BROAD Orgad ladder on the datasets that ACTUALLY have a __broad.json extraction:
# pubmed_qa, med_quad, expertqa (all long-form QA). med_quad + expertqa have NEVER been run broad, so this
# triples the genuine broad evidence base (1 dataset -> 3) at ZERO API cost.
# The driver now FAILS LOUD / skips any dataset lacking the variant cache, so sciq/trivia/xsum/samsum/cnn
# drop out instead of silently contributing uniform-mask (no-op) "Orgad" rows as they did before.
# CAVEAT to carry: with only 3 datasets available the training pools are REDUCED (long-form QA only,
# no DiffTask summarisation pool) -- this is a narrow but genuine ladder, not the full 5-rung one.
set -uo pipefail
cd "$PBS_O_WORKDIR"; source pbs/_env.sh; luq_activate || exit 1; cd "$LUQ_REPO"; export HF_HOME HF_HUB_OFFLINE=1
echo "=== orgad BROAD long-QA ladder on $(hostname) at $(date) ===" >&2
python -u scripts/checks/weighted_msp_orgad_ladder.py --seeds 1,2,3 --orgad-variant broad --orgad-floor 0.3 \
  --out results/weighted_msp_orgad_ladder__broad_longqa__meta-llama_Meta-Llama-3.1-8B.csv
echo "=== done $(date) ===" >&2
