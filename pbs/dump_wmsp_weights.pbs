#!/bin/bash
#PBS -l select=1:ncpus=4:mem=48gb
#PBS -l walltime=06:00:00
#PBS -N luq_wdump
#PBS -o /rds/general/ephemeral/user/gs925/ephemeral/luq_overnight_results/
#PBS -j oe
cd "$PBS_O_WORKDIR"; source pbs/_env.sh; luq_activate || exit 1; cd "$LUQ_REPO"; export HF_HOME HF_HUB_OFFLINE=1
echo "[wdump] host $(hostname) commit=$(git rev-parse --short HEAD 2>/dev/null)"
SLUG=meta-llama_Meta-Llama-3.1-8B
# per-dataset: train the wMSP variants on cached pertok (CPU, no GPU) and dump curated per-token weights.
for D in pubmed_qa med_quad asqa expertqa factscore xsum cnn_dailymail samsum; do
  OUT="cache/viz/${SLUG}__${D}__ID__wmsp_weights.npz"
  LF=correctness; [ "$D" = "expertqa" ] && LF=factuality; [ "$D" = "factscore" ] && LF=factuality
  echo "[wdump] === $D (label=$LF) ==="
  python -u scripts/tools/visualise_token_weights.py --dataset "$D" --label-field "$LF" --dump-weights "$OUT" || echo "[wdump] $D FAILED (continuing)"
done
echo "[wdump] DONE"
ls -la cache/viz/*wmsp_weights.npz 2>/dev/null
