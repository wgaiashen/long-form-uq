#!/bin/bash
#PBS -l select=1:ncpus=8:mem=96gb:ngpus=4:gpu_type=RTX6000
#PBS -l walltime=72:00:00
#PBS -N luq_ptmulti4
#PBS -j oe

# Per-token hidden states at the ten additional layers of the frozen layer-sensitivity set, run on
# four 24 GB cards instead of one 48 GB card. Registered in prereg/M9_layer_distance_sensitivity.md,
# which fixes the layer set and the analysis before any result exists.
#
# WHY THIS VARIANT EXISTS. It is the availability fallback, not a different experiment. The
# single-card version (pbs/pertoken_multilayer_llama.pbs) pins gpu_type=L40S and has been queued
# since 24 August. Measured at the time of writing: 55 of 56 L40S cards allocated with one node
# offline, every A100 and A40 card allocated or offline, and 38 RTX6000 cards free across two
# entirely idle nodes. The pin is the only reason the work is not running.
#
# WHY FOUR CARDS AND NOT TWO. Two 24 GB cards give 48 GB, matching what the single-card version
# asked for, and that is enough for the 32 GB of fp32 weights. It is not comfortable for the
# activations. This extraction runs the eager attention backend, which materialises the full
# attention matrix for one layer at a time, and the longest sources here are roughly 5,900 tokens:
# 32 heads x 5964^2 x 4 bytes is about 4.6 GB on top of whatever weights sit on that card. Four
# cards hold the weights at about 8 GB each and leave roughly 14 GB per card free, which absorbs
# that comfortably. Four cards were free on a single node when this was written.
#
# SHARDING CHANGES NO VALUE. Only the placement of the weights differs. The dtype, the sequence
# handling, the layers requested and the arithmetic are identical to a single-card run, and the
# driver asserts after loading that the split actually happened rather than assuming it. Note that
# device_map places layers in sequence rather than running them in parallel, so four cards do not
# make this four times faster; they buy memory headroom, not throughput.
#
# ONE DEVIATION TO RECORD. RTX6000 is a different GPU architecture from the cards that produced the
# already-cached middle layer, and kernel selection can differ between architectures. The precedent
# in this project is a relevance cache recomputed on a different card, which agreed with the original
# to a maximum of 1.9e-6 and a median of 1.8e-8. That is floating-point noise rather than a change of
# method, but the layer sensitivity compares ten new layers against a middle layer cached elsewhere,
# so the mixed provenance belongs in its write-up.
#
# THE FROZEN SET is range(0, 32, 3) = 0 3 6 9 12 15 18 21 24 27 30. Layer 15 is ALREADY CACHED and is
# deliberately absent: the extractor refuses to overwrite an existing layer, and the canonical
# middle-layer caches are the input to every published result here.
#
# CHUNKED FOR HOST MEMORY. One teacher-forced forward computes every layer, so extracting several at
# once costs one forward rather than several. The extractor holds each layer's states in memory until
# the dataset is done, and ten layers of the largest dataset would be roughly 70 GB resident. Three
# chunks keeps the peak near 32 GB. The boundaries are a memory decision and change no value.
#
# RESUMABLE, WHICH THE SINGLE-CARD VERSION IS NOT. Seventy-two hours is the queue maximum and this
# card is slower than the one originally requested, so running out of walltime is a real
# possibility. Before each chunk the script asks the cache which of those layers already exist and
# passes only the missing ones, which is exactly what the extractor's overwrite guard tells the
# caller to do. Resubmitting therefore continues from where it stopped instead of aborting on the
# first completed layer. A chunk whose layers are all present is skipped.
#
# DISK. Ten layers over eight datasets is about 192 GB. These caches are deleted once the per-layer
# distances have been computed from them; they are regenerable and are not an artifact to keep.
#
# THE REGIME OVERRIDE IS NOT OPTIONAL. Without it the corrected-span dataset resolves to the
# uncorrected namespace and the sensitivity would silently sit on a different population from the
# grid it is compared against.
#
#   qsub pbs/pertoken_multilayer_llama_4gpu.pbs

set -uo pipefail
cd "$PBS_O_WORKDIR"; source pbs/_env.sh; luq_activate || exit 1; cd "$LUQ_REPO"

mkdir -p logs
LIVE="logs/pertoken_multilayer_llama4__${PBS_JOBID%%.*}.log"
exec > >(tee -a "$LIVE") 2>&1
echo "live log: $LIVE"

export HF_HOME
export HF_HUB_OFFLINE=1
MODEL="meta-llama/Meta-Llama-3.1-8B"
export LUQ_REGIME="med_quad=cleanv2"

# Four ceilings of 10 GiB give 40 GiB for 32 GiB of weights and leave the rest of each card for
# activations. The driver exits if this does not produce a genuine split across devices.
MAXMEM="0=10GiB,1=10GiB,2=10GiB,3=10GiB"

CHUNKS=("0,3,6,9" "12,18,21,24" "27,30")

echo "=== multi-layer per-token extraction on four cards, $MODEL === host=$(hostname) at $(date)"
echo "commit: $(git rev-parse HEAD 2>/dev/null)"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null || echo "(no nvidia-smi)"
df -h /rds/general/user/gs925/home | tail -1

# Ask the cache which layers are already on disk, using the same Config and key the extractor uses so
# the answer cannot drift from the paths it will write. Prints the still-missing layers, or nothing.
missing_layers () {
  LUQ_DS="$1" LUQ_RG="$2" LUQ_LAYERS="$3" python - <<'PYEOF'
import os
from pathlib import Path
from luq import cache
from luq.config import Config
ds, rg = os.environ["LUQ_DS"], os.environ["LUQ_RG"]
layers = [int(x) for x in os.environ["LUQ_LAYERS"].split(",") if x.strip()]
cfg = Config(model_name="meta-llama/Meta-Llama-3.1-8B", dataset=ds, ood_setting="ID",
             prompt_regime=rg)
key = cache.run_key(cfg.model_name, cfg.dataset, cfg.ood_setting)
pdir = Path(cfg.cache_dir) / "pertok"
print(",".join(str(L) for L in layers if not (pdir / f"{key}__L{L}.npz").exists()))
PYEOF
}

for DS in pubmed_qa xsum cnn_dailymail samsum med_quad asqa expertqa factscore; do
  case "$DS" in
    med_quad)  REGIME="cleanv2" ;;
    asqa)      REGIME="asqa_rp12" ;;
    expertqa)  REGIME="expertqa_rp12" ;;
    factscore) REGIME="factscore_rp12" ;;
    *)         REGIME="" ;;
  esac
  for CH in "${CHUNKS[@]}"; do
    TODO="$(missing_layers "$DS" "$REGIME" "$CH")" || { echo "!!! could not resolve cache paths for $DS"; exit 4; }
    if [ -z "$TODO" ]; then
      echo "---- $DS  layers $CH  already cached, skipping"
      continue
    fi
    echo; echo "---- $DS  layers $TODO  (of chunk $CH, regime='${REGIME:-canonical}') at $(date) ----"
    python -u scripts/01p_pertoken_multi.py --model "$MODEL" --dataset "$DS" --ood ID \
        --layers "$TODO" --prompt-regime "$REGIME" --dtype fp32 --attn eager \
        --device-map auto --max-memory "$MAXMEM" \
        || { echo "!!! extraction FAILED for $DS layers $TODO"; exit 3; }
  done
  echo "---- $DS done at $(date); free space now:"; df -h /rds/general/user/gs925/home | tail -1
done

echo; echo "=== done at $(date) ==="
