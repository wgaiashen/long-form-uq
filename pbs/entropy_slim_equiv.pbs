#!/bin/bash
#PBS -l select=1:ncpus=8:mem=96gb:ngpus=3:gpu_type=RTX6000
#PBS -l walltime=02:00:00
#PBS -N luq_entgate
#PBS -j oe

# Gate for the suffix-only vocabulary projection in the token-entropy driver, on both models that
# need it. Writes nothing into any cache.
#
# It runs the longest records of the dataset with the longest sources, which is where the
# full-logits path is closest to not fitting and where any difference would be most visible. Both
# paths run in the same process on the same weights, and the comparison requires exact equality of
# the entropy vectors and of the chosen-token log-probabilities.
#
# THREE CARDS, AND NOT BECAUSE OF THE PROJECTION. The second model is 9.24B parameters, which is
# about 37 GB in fp32 and does not fit two 24 GB cards with room to work. The projection saving does
# nothing for weights, so the card count is set by the weights alone: three cards hold them at about
# 12.3 GB each. The gate prints the resident weight footprint per device separately from the forward
# peak so that this is a measurement rather than an assumption.
#
#   qsub pbs/entropy_slim_equiv.pbs

set -uo pipefail
cd "$PBS_O_WORKDIR"; source pbs/_env.sh; luq_activate || exit 1; cd "$LUQ_REPO"
export HF_HOME
export HF_HUB_OFFLINE=1

mkdir -p logs
LIVE="logs/entropy_slim_equiv__${PBS_JOBID%%.*}.log"
exec > >(tee -a "$LIVE") 2>&1
echo "live log: $LIVE"
echo "commit: $(git rev-parse HEAD 2>/dev/null)"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null || true

STATUS=0

echo; echo "################ meta-llama/Meta-Llama-3.1-8B ################"
python -u scripts/checks/entropy_slim_equiv.py \
    --model meta-llama/Meta-Llama-3.1-8B --dataset xsum --n 8 --longest \
    --dtype fp32 --attn eager \
    --device-map auto --max-memory "0=12GiB,1=12GiB,2=12GiB" || STATUS=1

echo; echo "################ google/gemma-2-9b ################"
python -u scripts/checks/entropy_slim_equiv.py \
    --model google/gemma-2-9b --dataset xsum --n 8 --longest \
    --dtype fp32 --attn eager \
    --device-map auto --max-memory "0=14GiB,1=14GiB,2=14GiB" || STATUS=1

echo; echo "=== entropy gate exit status $STATUS at $(date) ==="
exit $STATUS
