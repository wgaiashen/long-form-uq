#!/bin/bash
#PBS -l select=1:ncpus=8:mem=120gb:ngpus=4:gpu_type=RTX6000
#PBS -l walltime=03:00:00
#PBS -N luq_entgate
#PBS -j oe

# Gate for the suffix-only vocabulary projection in the token-entropy driver. Writes nothing into any
# cache. Two arms per model, because one arm alone cannot establish what is needed.
#
# ARM 1, EQUIVALENCE, on records BOTH paths can run. The comparison requires exact equality of the
# entropy vectors and of the chosen-token log-probabilities. It is capped in length by necessity, not
# convenience: see below.
#
# ARM 2, CAPABILITY, on the longest records, running only the suffix path. No comparison is possible
# there, and that is the finding rather than a gap.
#
# WHY THE CAP IS NECESSARY, measured rather than assumed. A first attempt ran the equivalence arm on
# the longest sources and the full-logits path died with a clean out-of-memory error, not the launch
# fault seen elsewhere: it tried to allocate 4.10 GiB, the eager attention matrix at 5,866 tokens,
# while already holding roughly 3.0 GiB of sequence-by-vocabulary logits, on a card with 3.71 GiB
# free. The old path simply cannot reach those records on a 24 GB card. That is the reason the suffix
# path is wanted, so it cannot also be a precondition for testing it.
#
# CARD COUNT IS SET BY WEIGHTS, NOT BY THE PROJECTION. Measured in that first attempt across three
# cards: 8.46, 10.56 and 10.89 GiB resident. The projection saving does nothing for weights. Four
# cards bring the first model to about 8 GiB each and the second, which is 9.24B parameters and about
# 37 GB in fp32, to about 9.3 GiB each, leaving roughly 14 GiB per card for the forward. The gate
# prints resident weights per device separately from the forward peak so this stays a measurement.
#
# Fragmentation contributed to that first failure (4.12 GiB reserved but unallocated), so the
# allocator is asked for expandable segments.
#
#   qsub pbs/entropy_slim_equiv.pbs

set -uo pipefail
cd "$PBS_O_WORKDIR"; source pbs/_env.sh; luq_activate || exit 1; cd "$LUQ_REPO"
export HF_HOME
export HF_HUB_OFFLINE=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

mkdir -p logs
LIVE="logs/entropy_slim_equiv__${PBS_JOBID%%.*}.log"
exec > >(tee -a "$LIVE") 2>&1
echo "live log: $LIVE"
echo "commit: $(git rev-parse HEAD 2>/dev/null)"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null || true

STATUS=0
MM4="0=10GiB,1=10GiB,2=10GiB,3=10GiB"
MM4G="0=11GiB,1=11GiB,2=11GiB,3=11GiB"

for SPEC in "meta-llama/Meta-Llama-3.1-8B:$MM4" "google/gemma-2-9b:$MM4G"; do
  M="${SPEC%%:*}"; MM="${SPEC#*:}"
  echo; echo "################ $M ################"
  echo "---- arm 1: equivalence, records both paths can run ----"
  python -u scripts/checks/entropy_slim_equiv.py --model "$M" --dataset xsum \
      --n 8 --longest --max-len 2500 --dtype fp32 --attn eager \
      --device-map auto --max-memory "$MM" || STATUS=1
  echo "---- arm 2: capability, the longest records, suffix path only ----"
  python -u scripts/checks/entropy_slim_equiv.py --model "$M" --dataset xsum \
      --n 4 --longest --slim-only --dtype fp32 --attn eager \
      --device-map auto --max-memory "$MM" || STATUS=1
done

echo; echo "=== entropy gate exit status $STATUS at $(date) ==="
exit $STATUS
