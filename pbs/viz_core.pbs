#!/bin/bash
#PBS -l select=1:ncpus=8:mem=64gb
#PBS -l walltime=03:00:00
#PBS -N luq_viz_core
#PBS -j oe
# Token-weight visualiser refresh for the 4 CORE datasets, so they pick up the NEW wMSP-entropy_hinge toggle
# (Joe item-1). CPU only. Runs in parallel with viz_new.pbs. mem=64gb for the xsum/pubmed ~2GB pertok caches.
set -uo pipefail
cd "$PBS_O_WORKDIR"; source pbs/_env.sh; luq_activate || exit 1; cd "$LUQ_REPO"; export HF_HOME
MODEL=meta-llama/Meta-Llama-3.1-8B
echo "=== viz CORE refresh on $(hostname) $(date) ===" >&2
for d in sciq trivia_qa pubmed_qa xsum; do
  echo "---- $d (test) $(date)" >&2
  python -u scripts/tools/visualise_token_weights.py --model "$MODEL" --dataset "$d" --ood ID --split test \
    || echo "!!! viz FAILED for $d" >&2
done
echo "=== done $(date) ===" >&2
