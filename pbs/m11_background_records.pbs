#!/bin/bash
#PBS -l select=1:ncpus=4:mem=48gb
#PBS -l walltime=02:00:00
#PBS -N luq_m11bgrec
#PBS -j oe

# Stage one of the background corpus for the full-layer reproduction, registered in
# prereg/M11_alllayer_published_distance_baselines.md.
#
# NO GPU AND NO GENERATION. The background states file already on disk carries the generated token
# identities for every row, and the prompts are a deterministic function of the C4 selection, the
# seed and the prompt cap. So the token records are rebuilt from that file with a tokenizer alone.
# This is not a shortcut: it makes the corpus provably the SAME corpus the existing single-layer
# background was fitted on, rather than a fresh sample that merely follows the same recipe.
#
# THE JOB IS ITS OWN GATE. Every row's re-derived prompt must have exactly the length the states file
# recorded, and the C4 row indices must match one for one. If either fails the script writes nothing.
#
#   qsub pbs/m11_background_records.pbs

set -uo pipefail
cd "$PBS_O_WORKDIR"; source pbs/_env.sh; luq_activate || exit 1; cd "$LUQ_REPO"

mkdir -p logs
LIVE="logs/m11_background_records__${PBS_JOBID%%.*}.log"
exec > >(tee -a "$LIVE") 2>&1
echo "live log: $LIVE"
echo "commit: $(git rev-parse HEAD 2>/dev/null)"

export HF_HOME
# NOT offline. The C4 selection is resolved through load_dataset, and its config hash depends on how
# the data files were resolved: offline it hashes differently from the online resolution that built
# the cache, and the lookup then fails with "Couldn't find cache for allenai/c4". The shard itself is
# already downloaded, so this costs a metadata call, not a download.
export HF_HUB_OFFLINE=0

MODEL="meta-llama/Meta-Llama-3.1-8B"
STATES="cache/background_c4/meta-llama_Meta-Llama-3.1-8B__L15__b384.npz"

echo "=== background records === host=$(hostname) at $(date)"
python -u scripts/01q_background_stats.py --model "$MODEL" \
    --from-existing-states "$STATES" --budget 384 \
    || { echo "!!! rebuild FAILED"; exit 3; }

echo; echo "=== done at $(date) ==="
