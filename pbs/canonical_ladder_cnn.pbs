#!/bin/bash
#PBS -l select=1:ncpus=2:mem=32gb
# Right-sized 2026-07-22 from MEASURED usage: these drivers run at CPU Percent 99% (single-threaded)
# and peak ~15.6GB, so the old 8cpu/96gb request just made them wait for a slot they never used.
#PBS -l walltime=08:00:00
#PBS -N luq_canon_cnn
#PBS -j oe
# cnn_dailymail as a full 5-rung OOD eval (all methods) once its per-token L15 cache landed from DoC.
# STEP 0 is an integrity GATE: the per-token window-mean must equal the cached SAPLMA L15 feature
# (~1e-4, fp32) -- the strong "not truncated + right dtype + right alignment" check (project conventions). If it
# fails, abort before the long ladder. STEP 1 runs the ladder with cnn as BOTH an eval target and a
# source (so it also completes the QA evals' DiffTask pool to the faithful 1800 in later QA runs).
set -uo pipefail
cd "$PBS_O_WORKDIR"; source pbs/_env.sh; luq_activate || exit 1; cd "$LUQ_REPO"; export HF_HOME HF_HUB_OFFLINE=1
echo "=== cnn ladder on $(hostname) at $(date) ===" >&2

echo "### STEP 0: integrity gate = the pipeline's PRR-match check ###" >&2
# The RIGHT check (verified 2026-07-16 vs known-good xsum): an element-wise window-mean vs SAPLMA-L15
# match is NOT achievable -- the SAPLMA feature was extracted sdpa/auto while 01h_pertoken uses eager,
# so fp32 attention numerics differ by ~0.2 element-wise (xsum, the good cache, differs by 0.236; cnn by
# 0.184). What MUST hold (and does) is the pipeline's own sanity: mean-pooling the per-token cache
# reproduces the cached SAPLMA feature's PRR. A truncated/misaligned cache would blow this up.
python - <<'PY'
import numpy as np, sys
sys.path.insert(0,"src"); sys.path.insert(0,"scripts/checks")
from luq import results, probe
from aggregation_table import load_per_token
M="meta-llama/Meta-Llama-3.1-8B"; slug="meta-llama_Meta-Llama-3.1-8B"
st,split,y,layer,recs=load_per_token(M,"cnn_dailymail",15,"correctness")
trn=[i for i in range(len(st)) if split[i]=="train"]; te=[i for i in range(len(st)) if split[i]=="test"]
ytr=np.array([y[i] for i in trn],float); yte=np.array([y[i] for i in te],float)
Xmean=np.stack([np.asarray(s).mean(axis=0) for s in st])
prr_pt=results.prr(yte, probe.uncertainty(probe.train_probe_mlp(Xmean[trn],ytr,seed=1), Xmean[te]))
sap=np.load(f"cache/features/{slug}__cnn_dailymail__ID__saplma.npz")["feats"][:,15,:]
prr_sap=results.prr(yte, probe.uncertainty(probe.train_probe_mlp(sap[trn],ytr,seed=1), sap[te]))
print(f"integrity(PRR-match): mean-pool-pertok PRR={prr_pt:.4f} vs cached-SAPLMA PRR={prr_sap:.4f}", flush=True)
if abs(prr_pt-prr_sap) > 0.03:
    sys.exit(f"INTEGRITY GATE FAILED: |{prr_pt:.4f}-{prr_sap:.4f}|>0.03 -> pertok inconsistent with SAPLMA feature")
print("INTEGRITY GATE OK (pertok mean-pool reproduces the SAPLMA feature PRR)", flush=True)
PY
[ $? -ne 0 ] && { echo "gate failed, aborting" >&2; exit 1; }

echo "### STEP 1: canonical ladder, cnn_dailymail eval (all methods, 5 rungs) ###" >&2
python -u scripts/checks/canonical_ladder.py --evals cnn_dailymail \
  --sources sciq,trivia_qa,pubmed_qa,xsum,med_quad,samsum,cnn_dailymail \
  --aggregators meanpool,lasttoken,persentence,pertoken --seeds 1,2,3 \
  --out results/canonical_ladder_cnn__meta-llama_Meta-Llama-3.1-8B.csv
echo "=== done at $(date) ===" >&2
