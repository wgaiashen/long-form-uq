#!/bin/bash
#PBS -l select=1:ncpus=8:mem=64gb
#PBS -l walltime=08:00:00
#PBS -N luq_aux1b
#PBS -j oe

# B.1 STAGE 1b -- the two variants Joe actually named, neither of which stage 1 tested.
#
# WHY THIS RUN EXISTS. Stage 1 swept lambda over [0.2, 1.8], the paper's range, and came back null:
# real-minus-shuffled was ~0 on all four cells and the supervision HURT pubmed by ~0.045. But two things
# make that an incomplete test rather than a verdict:
#
#   1. THREE OF FOUR CELLS SELECTED lambda = 0.2, the SMALLEST value offered. Validation was asking for
#      less supervision than the sweep floor, which means the optimum sits at or below it. And lambda=0
#      was never in the grid, so validation could not express "no supervision at all".
#   2. Joe's suggestion at the 31 July meeting was a LOW WEIGHT, ~0.1, kept on throughout -- below the
#      paper's range and below stage 1's floor. It was never run. His other suggestion, strong at the
#      start then removed after a few epochs, was never run either (the paper has no annealing schedule,
#      so this variant is his, not theirs).
#
# So this extends the sweep DOWNWARD and adds the schedule. If the low-weight arm is also null, the
# negative is then a real one covering the regime that was actually proposed.
#
# ARM A  lambda in {0, 0.05, 0.1, 0.2}, constant       -> Joe's low-weight regime; lambda=0 lets the
#                                                          validation pick "none", which is the honest
#                                                          control for a boundary selection.
# ARM B  lambda in {0.6, 1.0, 1.8}, dropped at epoch 20 -> "strong then removed" (60 epochs total).
#
#   qsub pbs/aux_attention_stage1b.pbs

set -uo pipefail
cd "$PBS_O_WORKDIR"
source pbs/_env.sh
luq_activate || exit 1
cd "$LUQ_REPO"
export HF_HOME
export HF_HUB_OFFLINE=1

echo "=== B.1 stage 1b on $(hostname) $(date) ===" >&2

echo "--- ARM A: low-weight constant, lambda in {0, 0.05, 0.1, 0.2} ---" >&2
python -u scripts/checks/aux_attention_ladder.py \
    --evals pubmed_qa,xsum --rungs ID --targets nll,content_mass \
    --lambdas 0,0.05,0.1,0.2 --seeds 1 \
    --out results/aux_attention_stage1b_lowlambda__meta-llama_Meta-Llama-3.1-8B.csv

echo "--- ARM B: strong then removed at epoch 20, lambda in {0.6, 1.0, 1.8} ---" >&2
python -u scripts/checks/aux_attention_ladder.py \
    --evals pubmed_qa,xsum --rungs ID --targets nll,content_mass \
    --lambdas 0.6,1.0,1.8 --drop-epoch 20 --seeds 1 \
    --out results/aux_attention_stage1b_dropsched__meta-llama_Meta-Llama-3.1-8B.csv

echo "=== stage 1b done $(date) ===" >&2
