#!/bin/bash
#PBS -l select=1:ncpus=8:mem=96gb
#PBS -l walltime=02:00:00
#PBS -N luq_m11bgd
#PBS -q v1_small72a
#PBS -j oe

# The background verification, as corrected by amendment A2 of the pre-registration: the two layer-15
# statistics are compared by the DISTANCES they produce, not by their matrix entries.
#
# One statistic was derived from the per-token states already on disk, with no model and no
# recomputation. The other was recomputed on the second cluster from the token records. Both are
# scored against the SAME rows here, so nothing depends on where either was fitted.
#
# The elementwise numbers are printed for the record and are NOT gated on. The bar is 1e-4 relative
# on the per-row distances, unchanged from every other distance comparison in this registration.
#
#   qsub pbs/m11_bgdist.pbs

set -uo pipefail
cd "$PBS_O_WORKDIR"; source pbs/_env.sh; luq_activate || exit 1; cd "$LUQ_REPO"

mkdir -p logs
LIVE="logs/m11_bgdist__${PBS_JOBID%%.*}.log"
exec > >(tee -a "$LIVE") 2>&1
echo "live log: $LIVE"
echo "commit: $(git rev-parse HEAD 2>/dev/null)"

SLUG="meta-llama_Meta-Llama-3.1-8B"
echo "=== background distance check === host=$(hostname) at $(date)"

python -u scripts/checks/m11_gates.py bgdist \
    --exact      "cache/background_c4_exact_l15/${SLUG}__bgstats__L15__b{b}__refwin.npz" \
    --recomputed "cache/background_c4/${SLUG}__bgstats__L15__b{b}__refwin.npz" \
    --states     "cache/background_c4/${SLUG}__L15__b384.npz" \
    --budgets 56,128,256,384 --n-score 400 || exit 3

echo; echo "=== done at $(date) ==="
