#!/bin/bash
#PBS -l select=1:ncpus=2:mem=32gb
#PBS -l walltime=16:00:00
#PBS -N luq_seg
#PBS -j oe
# W-B1 decompose-and-aggregate on EITHER ladder. LADDER=standard puts it on the ProbeDrift(XL) rungs (the
# same ones every other method is on, mixed short+long training pool); LADDER=long keeps the long-only pool.
set -uo pipefail
cd "$PBS_O_WORKDIR"; source pbs/_env.sh; luq_activate || exit 1; cd "$LUQ_REPO"; export HF_HOME HF_HUB_OFFLINE=1
D="${EVAL:?set EVAL}"; L="${LADDER:-long}"
echo "=== seg_aggregate eval=$D ladder=$L on $(hostname) $(date) ===" >&2
python -u scripts/checks/seg_aggregate_ladder.py --seeds 1,2,3 --evals "$D" --ladder "$L" \
  --out "results/seg_aggregate_${L}_${D}__meta-llama_Meta-Llama-3.1-8B.csv"
echo "=== done $(date) ===" >&2
