#!/bin/bash
#PBS -l select=1:ncpus=4:mem=64gb:ngpus=1:gpu_type=L40S
#PBS -l walltime=08:00:00
#PBS -N luq_neighbour
#PBS -j oe

# Extract an OOD NEIGHBOUR dataset (e.g. med_quad, a same-task neighbour of pubmed_qa) with the
# SAME config as the frozen Llama keystone runs -- fp32 + eager -- so its per-token states are
# poolable with the other datasets' caches in the OOD ladder. Also passes --truncate-long so the
# few-shot 'Question:/Answer:' format is cut at the first newline (the trivia-style junk fix), while
# the dataset stays judge-labelled (it is NOT in data.SHORT_FORM).
#
# Generation only. Labelling (02_label, gpt-5-mini, LOGIN node, costs £) and per-token extraction
# (01h_pertoken, a second GPU job) follow once this finishes.
#
#   qsub -v LUQ_DATASET=med_quad pbs/extract_neighbour.pbs

set -uo pipefail

cd "$PBS_O_WORKDIR"
source pbs/_env.sh
luq_activate || exit 1
cd "$LUQ_REPO"

export HF_HOME   # set by pbs/_env.sh, off $HOME

DATASET="${LUQ_DATASET:-med_quad}"
MODEL="${LUQ_MODEL:-meta-llama/Meta-Llama-3.1-8B}"

# Anti-loop decoding (v4). Open-ended neighbours have no natural stop on base Llama and loop to the
# budget. Use --no-repeat-ngram-size 3 ALONE (no --repetition-penalty): no_repeat_ngram forbids
# repeating a 3-gram WITHIN the generation (kills the v1 loops) without penalising the reuse of
# context words a real answer legitimately repeats. NO --truncate-long: med_quad is tagged long_qa and
# must match its long-form sibling pubmed_qa, generated UNtruncated.
#   History: v1 (truncate-long, no anti-loop) = no-op truncation [0 newlines], 67% capped / 11% loops.
#   v2 (rep_pen + truncate-long) cut the newline rep_pen emits first -> 35% EMPTY. v3 (rep_pen, no
#   truncation) STILL 35% empty -> root cause = rep_pen penalises the long few-shot context, pushing
#   immediate EOS. v4 drops rep_pen for no_repeat_ngram, which has no context-penalty side effect.
echo "neighbour extract v4: dataset=$DATASET model=$MODEL (fp32 + eager + no_repeat_ngram=3, long-form/untruncated) on $(hostname) at $(date)" >&2
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader || true
python scripts/01_extract.py --dataset "$DATASET" --ood ID --model "$MODEL" \
    --dtype fp32 --attn eager \
    --no-repeat-ngram-size 3
