#!/bin/bash
#PBS -l select=1:ncpus=2:mem=32gb
# Right-sized 2026-07-22 from MEASURED usage: these drivers run at CPU Percent 99% (single-threaded)
# and peak ~15.6GB, so the old 8cpu/96gb request just made them wait for a slot they never used.
#PBS -l walltime=08:00:00
#PBS -N luq_wmsp_keep
#PBS -j oe
# design note 4: constrain the learned weighting to token subsets (special / special+punct / content), across
# the full ladder × all evals. CPU-only. mem=96gb (cnn pertok as a source).
set -uo pipefail
cd "$PBS_O_WORKDIR"; source pbs/_env.sh; luq_activate || exit 1; cd "$LUQ_REPO"; export HF_HOME HF_HUB_OFFLINE=1
echo "=== wMSP keep-variants on $(hostname) at $(date) ===" >&2
# LUQ_LOSS (pairwise|blondel) selects the ranking loss; blondel writes to its OWN csv so the committed
# pairwise numbers are never overwritten (qsub -v LUQ_LOSS=blondel).
LOSS="${LUQ_LOSS:-pairwise}"
if [ "$LOSS" = "blondel" ]; then
  OUT="--out results/weighted_msp_keep_variants__blondel__meta-llama_Meta-Llama-3.1-8B.csv"
else
  OUT=""
fi
echo "loss=$LOSS $OUT" >&2
python -u scripts/checks/weighted_msp_keep_variants.py --seeds 1,2,3 --loss "$LOSS" $OUT
echo "=== done $(date) ===" >&2
