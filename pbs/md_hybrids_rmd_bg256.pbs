#!/bin/bash
#PBS -l select=1:ncpus=8:mem=96gb
#PBS -l walltime=24:00:00
#PBS -N luq_rmd256
#PBS -j oe

# Relative-distance grid for the datasets generated at 256 tokens: asqa,factscore.
# The background is sliced to 256 generated tokens so it matches their generation length.
# Rationale, and why the run is partitioned by budget, is in pbs/_md_hybrids_rmd_body.sh.
# CPU only: every input already exists.
#
#   qsub pbs/md_hybrids_rmd_bg256.pbs

export LUQ_RMD_EVALS="asqa,factscore"
export LUQ_RMD_BUDGET=256
export LUQ_RMD_TAG=bg256

source "$PBS_O_WORKDIR/pbs/_md_hybrids_rmd_body.sh"
