#!/bin/bash
#PBS -l select=1:ncpus=8:mem=120gb
#PBS -l walltime=12:00:00
#PBS -N luq_m11gb1
#PBS -q v1_small72a
#PBS -j oe

# Gate B, first half: the single-layer driver re-run, and the invariance control on it.
# Registered in prereg/M11_alllayer_published_distance_baselines.md section 5.
#
# WHY THIS IS THE CONTROL AND NOT YET THE GATE. The only change made to that driver was to move the
# reduction ahead of the two probability columns, which at one cached layer cannot fire at all
# because the reduction needs ten columns and there are at most three. So the correct result here is
# that NOTHING MOVES. A driver correction that moves a single-layer number is a correction in the
# wrong place. The run also dumps its per-example distances, which is what the gate itself compares
# against in the second half.
#
# SPLIT IN TWO, AND SHORT. The two halves were one job asking for a day of walltime, which on a queue
# this busy backfills badly: a five-minute job here waited 47 minutes while a day-long one waited
# longer. Each half is independently useful and neither needs the other running.
#
#   qsub pbs/m11_gate_b1.pbs
set -uo pipefail
cd "$PBS_O_WORKDIR"; source pbs/_env.sh; luq_activate || exit 1; cd "$LUQ_REPO"

mkdir -p logs
LIVE="logs/m11_gate_b1__${PBS_JOBID%%.*}.log"
exec > >(tee -a "$LIVE") 2>&1
echo "live log: $LIVE"
echo "commit: $(git rev-parse HEAD 2>/dev/null)"

export LUQ_REGIME="med_quad=cleanv2"
MODEL="meta-llama/Meta-Llama-3.1-8B"
SLUG="meta-llama_Meta-Llama-3.1-8B"
REF="results/hybrids/pdl_hybrids_unconstrained__${SLUG}.csv"
CTL="results/hybrids/pdl_m11_singlelayer_control__${SLUG}.csv"

echo "=== gate B, first half === host=$(hostname) at $(date)"

echo; echo "################ port equivalence against the reference implementation ################"
python -u scripts/checks/md_port_equivalence.py \
    || { echo "!!! port equivalence FAILED -- refusing to run"; exit 2; }

echo; echo "################ the single-layer driver, unchanged window ################ $(date)"
python -u scripts/checks/md_hybrids.py --model "$MODEL" --layer 15 --seeds 1,2,3 \
    --window project --dump-md-dir "results/hybrids/mdhybdump__${SLUG}" --out "$CTL" \
    || { echo "!!! single-layer control FAILED"; exit 3; }

echo; echo "################ the invariance control: nothing may have moved ################"
python -u scripts/checks/m11_invariance.py --new "$CTL" --recorded "$REF" || exit 4

echo; echo "=== first half done at $(date). Second half:"
echo "      qsub pbs/m11_gate_b2.pbs"
