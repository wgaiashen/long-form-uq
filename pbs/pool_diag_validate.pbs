#!/bin/bash
#PBS -l select=1:ncpus=2:mem=16gb
#PBS -l walltime=00:20:00
#PBS -N luq_pooldiag
#PBS -o /rds/general/ephemeral/user/gs925/ephemeral/luq_overnight_results/
#PBS -j oe
cd "$PBS_O_WORKDIR"; source pbs/_env.sh; luq_activate || exit 1; cd "$LUQ_REPO"; export HF_HOME HF_HUB_OFFLINE=1
# validate the E2 diagnostic on the existing ID sidecars (short/med/long span) -- proves the per-example
# sharpness panel computes sane numbers before E1's OOD sidecars land.
python -u scripts/checks/pool_attention_ood_diag.py --datasets sciq,trivia_qa,pubmed_qa,xsum
