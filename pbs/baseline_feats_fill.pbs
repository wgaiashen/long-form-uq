#!/bin/bash
#PBS -l select=1:ncpus=4:mem=96gb:ngpus=1:gpu_type=A100
#PBS -l walltime=08:00:00
# RCS FALLBACK ONLY — this work went to DoC (job 3535876 was qdel'd after sitting 7h in v1_gpu72).
# A100, not L40S: cnn_dailymail's longest sequence is 2467 tokens, capped to 2048, so lookback's
# all-layer attention tensor is 32 x 32 x 2048^2 x 4B = 17.2 GB on top of ~32 GB fp32 weights = 49.2 GB,
# over the 48 GB L40S/A40. NOTE RCS's A100 is a 40GB card, so this may not fit here EITHER — that is
# precisely why the job belongs on DoC's 80GB A100. Re-check before relying on this file.
#PBS -N luq_basefeats
#PBS -j oe

# STEP A of the ladder-completion plan: extract the two SUPERVISED BASELINE feature sets that are
# missing for three datasets, so P(True) and Lookback Lens can appear on the full grid.
#
# WHY THIS IS THE GATE. assemble_pdl_table.py's ALIAS defines a 24-method universe that contains NO
# ptrue, NO lookback and NO uhead -- i.e. none of the supervised baselines the report's central claim
# ("our method beats existing probes") is measured against. The features exist for 7 of 10 datasets;
# cnn_dailymail, med_quad and samsum are missing both. Six extractions unlock the whole comparison.
#
# NAMING MATTERS: --name ptrue_accurate, matching slurm/ptrue_accurate_extract.sbatch and the wording
# "Is the above response accurate?" already used on the other seven. A different name would silently
# create a second, non-comparable feature set and the ladder would mix wordings across datasets.
#
# fp32 + L15. med_quad/cnn/samsum have short-to-medium sources and fit the L40S in fp32 (it is xsum's
# ~5,600-token articles that OOM there, and xsum already HAS both features).
#
#   qsub -v LUQ_DATASETS=cnn_dailymail,med_quad,samsum pbs/baseline_feats_fill.pbs

set -uo pipefail
cd "$PBS_O_WORKDIR"
source pbs/_env.sh
luq_activate || exit 1
cd "$LUQ_REPO"
export HF_HOME
export HF_HUB_OFFLINE=1

MODEL="${LUQ_MODEL:-meta-llama/Meta-Llama-3.1-8B}"
DATASETS="${LUQ_DATASETS:-cnn_dailymail,med_quad,samsum}"
echo "baseline feature fill on $(hostname) at $(date): datasets=$DATASETS model=$MODEL"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader || echo "(no GPU -- will fall back to CPU)"

IFS=',' read -ra DS_ARR <<< "$DATASETS"
for DS in "${DS_ARR[@]}"; do
  echo "======== $DS : 01b_ptrue --name ptrue_accurate ======== $(date)"
  # --store-layers 15 IS NOT OPTIONAL (caught on DoC 2026-08-03, verified here). 01b_ptrue defaults
  # to `all`, writing real values for all 33 layers instead of NaN-padding to layer 15. The seven
  # existing caches are (n, 33, 4096) with ONLY layer 15 finite, 33-44MB each; without the flag these
  # would be ~2GB for cnn alone and NON-COMPARABLE with them, and verify_baseline_features.py would fail
  # on the finite-layer pattern.
  python -u scripts/01b_ptrue.py --dataset "$DS" --ood ID --model "$MODEL" \
      --name ptrue_accurate --store-layers 15 || echo "!!! ptrue_accurate FAILED for $DS"

  echo "======== $DS : 01c_lookback ======== $(date)"
  python -u scripts/01c_lookback.py --dataset "$DS" --ood ID --model "$MODEL" \
      || echo "!!! lookback FAILED for $DS"
done

echo "======== VERIFY (never trust presence alone) ======== $(date)"
# --datasets IS REQUIRED. Without it the script prints usage, exits non-zero, and trips the `||`,
# so the log reads "!!! ... reported a problem" when verification NEVER RAN — indistinguishable from a
# genuinely corrupt cache. Same bug DoC found in the sbatch twin on 2026-08-04.
python -u scripts/checks/verify_baseline_features.py --datasets "${DATASETS//,/ }" \
    || echo "!!! verify_baseline_features reported a problem"
echo "DONE $(date)"
