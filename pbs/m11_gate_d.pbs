#!/bin/bash
#PBS -l select=1:ncpus=2:mem=16gb
#PBS -l walltime=01:00:00
#PBS -N luq_m11gd
#PBS -q v1_small72a
#PBS -j oe

# Gate D, the cross-cluster sentinel. Registered in amendment A1.4 of
# prereg/M11_alllayer_published_distance_baselines.md. STOP RULE.
#
# Layer 15 is computed independently on both clusters: this one scans it from the states cached here,
# the other extracts it from the model and scans it there. The two sets of per-example mean distances,
# AND their relative-distance versions, must agree to 1e-4 relative.
#
# THIS IS THE MEASUREMENT THE EARLIER LAYER REGISTRATION STOPPED SHORT OF. That one compared hidden
# states recomputed on a different accelerator, found they differed in their last bits, and stopped.
# It never asked whether such a difference survives into a distance. This asks exactly that, end to
# end, on the foreground states rather than the background.
#
# THE TWO SIDES LIVE IN DIFFERENT DIRECTORIES ON PURPOSE. Both clusters produce files with identical
# names, so the second cluster's layer 15 is kept apart; putting them together would overwrite one
# side of the comparison with the other.
#
#   qsub pbs/m11_gate_d.pbs

set -uo pipefail
cd "$PBS_O_WORKDIR"; source pbs/_env.sh; luq_activate || exit 1; cd "$LUQ_REPO"

mkdir -p logs
LIVE="logs/m11_gate_d__${PBS_JOBID%%.*}.log"
exec > >(tee -a "$LIVE") 2>&1
echo "live log: $LIVE"
echo "commit: $(git rev-parse HEAD 2>/dev/null)"

SLUG="meta-llama_Meta-Llama-3.1-8B"
A="results/hybrids/mdscan_refwin__${SLUG}"
B="results/hybrids/mdscan_refwin_doc_l15__${SLUG}"

echo "=== gate D === host=$(hostname) at $(date)"
NA=$(ls "$A"/L15__*.npz 2>/dev/null | wc -l)
NB=$(ls "$B"/L15__*.npz 2>/dev/null | wc -l)
echo "this cluster: $NA cells | other cluster: $NB cells (40 expected each)"
if [ "$NA" -ne 40 ] || [ "$NB" -ne 40 ]; then
  echo "!!! both sides need all 40 cells before this means anything. Not run."
  exit 2
fi

python -u scripts/checks/m11_gates.py d --a "$A" --b "$B" --layer 15 || exit 3

echo; echo "=== done at $(date) ==="
