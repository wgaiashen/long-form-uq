#!/bin/bash
#PBS -l select=1:ncpus=4:mem=64gb
#PBS -l walltime=03:00:00
#PBS -N luq_allviz
#PBS -o /rds/general/ephemeral/user/gs925/ephemeral/luq_overnight_results/
#PBS -j oe
cd "$PBS_O_WORKDIR"; source pbs/_env.sh; luq_activate || exit 1; cd "$LUQ_REPO"; export HF_HOME HF_HUB_OFFLINE=1
# All-methods token overlay. One or more datasets via -v DATASETS="pubmed_qa,cnn_dailymail,..."
# (comma-sep). CPU; loads each dataset's pertok once.
echo "[allviz] host $(hostname) DATASETS=$DATASETS"
IFS=',' read -ra DS <<< "$DATASETS"
for d in "${DS[@]}"; do
  echo "=== $d ==="
  python -u scripts/tools/visualise_allmethods.py --dataset "$d" || echo "  [FAIL $d]"
done
echo "[allviz] DONE"
