#!/bin/bash
#PBS -l select=1:ncpus=8:mem=120gb
#PBS -l walltime=03:00:00
#PBS -N luq_m11bgsens
#PBS -q v1_small72a
#PBS -j oe

# Does a failing elementwise background comparison mean the DISTANCES have moved?
#
# The background verification compares two fitted statistics by their largest elementwise relative
# difference. On the other cluster's recomputed layer 15 that comparison failed, by four to twenty
# times on the centroid and by three to four orders of magnitude on the inverse covariance.
#
# Before anything is concluded from that, the question this answers is whether the comparison can
# tell the difference between a background that changes the distances and one that does not. An
# inverse covariance is consumed as a quadratic form over sixteen million terms, and inverting a
# near-singular covariance is precisely where a small input change can move an individual entry a
# long way while the form itself barely moves.
#
# NOTHING IS WRITTEN and no threshold is changed by this job. It is a measurement of the instrument.
#
#   qsub pbs/m11_bg_sensitivity.pbs

set -uo pipefail
cd "$PBS_O_WORKDIR"; source pbs/_env.sh; luq_activate || exit 1; cd "$LUQ_REPO"

mkdir -p logs
LIVE="logs/m11_bg_sensitivity__${PBS_JOBID%%.*}.log"
exec > >(tee -a "$LIVE") 2>&1
echo "live log: $LIVE"
echo "commit: $(git rev-parse HEAD 2>/dev/null)"

echo "=== background gate sensitivity === host=$(hostname) at $(date)"
python -u scripts/checks/m11_bg_sensitivity.py \
    --states cache/background_c4/meta-llama_Meta-Llama-3.1-8B__L15__b384.npz \
    --budget 384 --scales 1e-7,1e-6,1e-5 || exit 3

echo; echo "=== done at $(date) ==="
