#!/bin/bash
#PBS -l select=1:ncpus=4:mem=64gb
#PBS -l walltime=04:00:00
#PBS -N luq_w2_smoke
#PBS -o /rds/general/ephemeral/user/gs925/ephemeral/luq_overnight_results/
#PBS -j oe
# W2 SMOKE TEST -- one cell, one seed. Output is LABELLED as a smoke test and must NEVER enter a
# results table (standing evaluation rule).
#
# THE ONE THING THIS EXISTS TO CHECK: the no-op arm (T0=1, gamma=0) must reproduce that cell's
# wMSP-norm entry in the master ladder to within seed noise. If it does not, the temperature wiring
# has changed the base method and every W2 number after it would be meaningless.
#
# CPU only, no GPU. Trains one weighter, then re-scores the whole (T0, gamma) grid off it.
cd "$PBS_O_WORKDIR"; source pbs/_env.sh; luq_activate || exit 1; cd "$LUQ_REPO"; export HF_HOME HF_HUB_OFFLINE=1
export LUQ_CARVE=legacy
echo "HOST $(hostname)"
python -u scripts/checks/sharpening_wmsp.py --evals pubmed_qa --seeds 1 --smoke
echo "[w2-smoke] DONE"
