#!/bin/bash
#PBS -l select=1:ncpus=4:mem=64gb
#PBS -l walltime=03:00:00
#PBS -N luq_router_pdl
#PBS -o /rds/general/ephemeral/user/gs925/ephemeral/luq_overnight_results/
#PBS -j oe
cd "$PBS_O_WORKDIR"; source pbs/_env.sh; luq_activate || exit 1; cd "$LUQ_REPO"; export HF_HOME HF_HUB_OFFLINE=1
# 3B: length router + continuous blend on the canonical cells_long OOD cells (floor+length from cached
# logprobs, pooler from the saved seed-1 poolers). NO training, no source-pool load.
echo "[3B] host $(hostname)"
python -u scripts/checks/router_pdl.py \
    --out /rds/general/ephemeral/user/gs925/ephemeral/luq_overnight_results/router_pdl__meta-llama_Meta-Llama-3.1-8B.csv
echo "[3B] DONE"
