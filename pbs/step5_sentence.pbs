#!/bin/bash
#PBS -l select=1:ncpus=4:mem=12gb
#PBS -l walltime=01:00:00
#PBS -N luq_step5_sentence
#PBS -j oe
set -uo pipefail
cd "$PBS_O_WORKDIR"; source pbs/_env.sh; luq_activate || exit 1; cd "$LUQ_REPO"; export HF_HOME
echo "=== step5 sentence mapping on $(hostname) at $(date) ===" >&2
python -u scripts/checks/check_sar_sentence_mapping.py --n 40
echo "=== done ===" >&2
