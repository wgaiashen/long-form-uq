#!/bin/bash
#PBS -l select=1:ncpus=8:mem=24gb
#PBS -l walltime=02:00:00
#PBS -N luq_viz_tw
#PBS -j oe
set -uo pipefail
cd "$PBS_O_WORKDIR"
source pbs/_env.sh
luq_activate || exit 1
cd "$LUQ_REPO"
export HF_HOME
echo "=== visualise token weights on $(hostname) at $(date) ===" >&2
python -u scripts/tools/visualise_token_weights.py --out results/viz/token_weights.html --per 4
echo "=== done at $(date) ===" >&2
