#!/bin/bash
#PBS -l select=1:ncpus=8:mem=48gb
#PBS -l walltime=03:00:00
#PBS -N luq_viz_tw
#PBS -j oe
# Per-dataset weighted-MSP-family visualiser (CPU only -- trains the wMSP MLP + frozen-query
# pooler on the ALREADY-cached per-token states; no model forward). mem=48gb because the xsum
# and pubmed pertok npz are ~2GB each and load into RAM.
#
# Renders ONE HTML per dataset: results/viz/token_weights__<key>.html, with the same toggle UI
# as visualise_attention.py. Optional toggles (orgad, SAR) appear only where their cache exists.
#
# Default: loop over the 4 core datasets (test split). Override with:
#   qsub -v DS=sciq pbs/viz_token_weights.pbs
#   qsub -v DS="med_quad samsum",SPLIT=train pbs/viz_token_weights.pbs   # train-only sets (no test rows)
set -uo pipefail
cd "$PBS_O_WORKDIR"
source pbs/_env.sh
luq_activate || exit 1
cd "$LUQ_REPO"
export HF_HOME

MODEL=meta-llama/Meta-Llama-3.1-8B
DATASETS="${DS:-sciq trivia_qa pubmed_qa xsum}"
SPLIT="${SPLIT:-test}"

echo "=== visualise token weights on $(hostname) at $(date) | datasets: $DATASETS | split: $SPLIT ===" >&2
for d in $DATASETS; do
  echo "---- $d ($SPLIT) ---- $(date)" >&2
  python -u scripts/tools/visualise_token_weights.py --model "$MODEL" --dataset "$d" --ood ID \
    --split "$SPLIT" \
    || echo "!!! token-weights viz FAILED for $d" >&2
done
echo "=== done at $(date) ===" >&2
