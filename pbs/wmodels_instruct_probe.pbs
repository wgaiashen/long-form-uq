#!/bin/bash
#PBS -l select=1:ncpus=2:mem=32gb:ngpus=1:gpu_type=RTX6000
#PBS -l walltime=00:40:00
#PBS -N luq_wm_iprobe
#PBS -j oe

# DIAGNOSTIC ONLY -- predicts whether an instruct checkpoint will hit the two failures that withdrew
# gemma-2-9b-it (prereg M5 D1), BEFORE it consumes a scarce 48GB card for 12 hours:
#   1. whitespace-fronting  -> a leading newline, which --truncate-long then cuts to EMPTY
#   2. assistant persona    -> trailing chatter the judge grades as the answer
#
# THIS IS NOT A POPULATION. It writes NOTHING to any cache, runs in bf16 on an abundant card
# purely because "is the first emitted token a newline?" is not dtype-sensitive, and its output may
# never enter a results table. The real fp32 run remains the population.
#
# It generates WITHOUT truncate_at_newline and inspects the first token itself. Reproducing the
# CAUSE (a leading newline) is more informative than the symptom (an empty string), and it also shows
# what the untruncated answer would have been.

set -uo pipefail
cd "$PBS_O_WORKDIR"; source pbs/_env.sh; luq_activate || exit 1; cd "$LUQ_REPO"
export HF_HOME
mkdir -p logs
LIVE="logs/wmodels_instruct_probe__${PBS_JOBID%%.*}.log"
exec > >(tee -a "$LIVE") 2>&1

python -u scripts/checks/wmodels_instruct_probe.py --model "${LUQ_MODEL:-meta-llama/Llama-3.1-8B-Instruct}"
STATUS=$?
echo "=== instruct probe done status=$STATUS at $(date) ===" >&2
exit $STATUS
